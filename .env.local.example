# Copy this file to .env.local and fill in your values

# Required: Anthropic API key for the narrator
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model ID for the narrator (default: claude-haiku-5-5)
# NARRATOR_MODEL=claude-haiku-5-5

# Optional: Base URL for the warm script (default: http://localhost:3000)
# WARM_BASE_URL=http://localhost:3000
